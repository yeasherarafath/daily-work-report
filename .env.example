GITHUB_TOKEN=ghp_xxxx
GITHUB_USERNAME=yeasherarafath

# Mistral provider (used by the `mistral` branch)
MISTRAL_API_KEY=xxxxxx
MISTRAL_MODEL="xxxxx"

# Groq provider (used by the `groq` branch)
GROQ_API_KEY=gsk_xxxx
GROQ_MODEL=openai/gpt-oss-120b

# Optional, reasoning models only. Accepted values differ per model:
#   openai/gpt-oss-*  -> low | medium | high   ("default" is rejected with HTTP 400)
#   qwen/qwen3.*      -> default | none
# Leave commented out to omit the parameter entirely (works on every model).
#GROQ_REASONING_EFFORT=medium

# Figma (used by the `figma` branch)
# Personal access token: Figma > Settings > Security > Personal access tokens.
# Read-only scopes needed (Figma UI label -> API scope):
#   Users > Read the current user's name, email...      current_user:read
#   Files > Read the contents of and render images...   file_content:read
#   Files > Read metadata of files                      file_metadata:read
#   Files > Read version history of files               file_versions:read
#   Files > Read comments in accessible files           file_comments:read
#   Folders > Read team folder structure                projects:read / folders:read
# No write scopes are needed.
FIGMA_TOKEN=figd_xxxx
# Team IDs from the team page URL: figma.com/files/team/<TEAM_ID>/...
FIGMA_TEAM_IDS=
# Extra files, e.g. drafts (the API cannot list drafts). Keys or full URLs, comma-separated.
FIGMA_FILE_KEYS=
# Only report files I edited today (default true)
#FIGMA_ONLY_MINE=true
